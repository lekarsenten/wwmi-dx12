  <Target Name="WwmiPristineSources" BeforeTargets="ClCompile">
    <ReadLinesFromFile File="$(WwmiRoot)reshade_addon\migoto\PRISTINE.txt">
      <Output TaskParameter="Lines" ItemName="WwmiPristineLine" />
    </ReadLinesFromFile>
    <Copy SkipUnchangedFiles="true" SourceFiles="$(WwmiRefDir)\%(WwmiPristineLine.Identity)" DestinationFolder="$(WwmiPristineDir)" Condition="!$([System.String]::Copy('%(WwmiPristineLine.Identity)').StartsWith('#'))" />
    <Exec Command="git -C &quot;$(WwmiRefDir)&quot; describe --tags --match v[0-9]* --abbrev=0" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="WwmiRefTag" />
    </Exec>
    <PropertyGroup>
      <WwmiRefTag>$(WwmiRefTag.Trim())</WwmiRefTag>
      <WwmiRefTag Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(WwmiRefTag)', '^v?\d+\.\d+\.\d+$'))">$(WwmiRefTag).0</WwmiRefTag>
      <WwmiRefVersionOk>$([System.Text.RegularExpressions.Regex]::IsMatch('$(WwmiRefTag)', '^v?\d+\.\d+\.\d+\.\d+$'))</WwmiRefVersionOk>
      <WwmiRefPattern>^v?(\d+)\.(\d+)\.(\d+)\.(\d+)$</WwmiRefPattern>
    </PropertyGroup>
    <WriteLinesToFile Condition="'$(WwmiRefVersionOk)' == 'True'" File="$(WwmiPristineDir)\version.generated.h" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="#define VERSION_MAJOR $([System.Text.RegularExpressions.Regex]::Replace('$(WwmiRefTag)', '$(WwmiRefPattern)', '$1'));#define VERSION_MINOR $([System.Text.RegularExpressions.Regex]::Replace('$(WwmiRefTag)', '$(WwmiRefPattern)', '$2'));#define VERSION_REVISION $([System.Text.RegularExpressions.Regex]::Replace('$(WwmiRefTag)', '$(WwmiRefPattern)', '$3'));#define VERSION_BUILD $([System.Text.RegularExpressions.Regex]::Replace('$(WwmiRefTag)', '$(WwmiRefPattern)', '$4'))" />
    <WriteLinesToFile Condition="'$(WwmiRefVersionOk)' != 'True'" File="$(WwmiPristineDir)\version.generated.h" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// no version tag in the submodule: version.h falls back to 0.0.0.0" />
  </Target>

