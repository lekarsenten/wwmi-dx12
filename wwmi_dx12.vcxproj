  <UsingTask TaskName="WwmiWriteBuildStamp" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
string root = Root.TrimEnd('\\');
Func<string, string> git = args =>
{
    try
    {
        var start = new ProcessStartInfo("git", "-C \"" + root + "\" " + args)
        {
            UseShellExecute = false,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            CreateNoWindow = true,
        };
        using (var p = Process.Start(start))
        {
            string text = p.StandardOutput.ReadToEnd();
            p.StandardError.ReadToEnd();
            p.WaitForExit();
            return p.ExitCode == 0 ? text.Trim() : "";
        }
    }
    catch (Exception)
    {
        return "";
    }
};
string sha = git("rev-parse --short HEAD");
if (sha.Length == 0) sha = "unknown";
string version = File.Exists(Path.Combine(root, "VERSION")) ? File.ReadAllText(Path.Combine(root, "VERSION")).Trim() : "dev";
string dirty = git("status --porcelain --untracked-files=no").Length != 0 ? "+dirty" : "";
string[] versionParts = version.Split('.');
int[] versionNum = new int[4];
for (int i = 0; i < versionParts.Length && i < 4; ++i)
{
    int n;
    if (int.TryParse(versionParts[i], out n) && n >= 0 && n <= 65535) versionNum[i] = n;
}
string[] rfxFiles =
{
    @"reshade_addon\rabbitfx\rfx_dxil.cpp",
    @"reshade_addon\rabbitfx\rfx_dxil.h",
    @"reshade_addon\rfx_glow_ir.inc",
    @"reshade_addon\rabbitfx\rfx_patch.h",
    @"reshade_addon\rabbitfx\rfx_patch.cpp",
};
var rfxBytes = new MemoryStream();
foreach (string f in rfxFiles)
{
    byte[] b = File.ReadAllBytes(Path.Combine(root, f));
    rfxBytes.Write(b, 0, b.Length);
}
string rfxHash = BitConverter.ToString(SHA256.Create().ComputeHash(rfxBytes.ToArray()), 0, 4).Replace("-", "");
string stamp = "// GENERATED by wwmi_dx12.vcxproj (WwmiBuildStamp) -- do not edit, not tracked.\r\n#pragma once\r\n" +
               "#define WWMI_VERSION \"" + version + "\"\r\n#define WWMI_BUILD_SHA \"" + sha + dirty + "\"\r\n" +
               "#define WWMI_VERSION_NUM " + string.Join(",", versionNum) + "\r\n" +
               "#define WWMI_RFX_SRC_HASH 0x" + rfxHash + "u\r\n";
string output = Path.Combine(root, @"reshade_addon\build_stamp.h");
if (!File.Exists(output) || File.ReadAllText(output) != stamp) File.WriteAllText(output, stamp, Encoding.ASCII);
]]></Code>
    </Task>
  </UsingTask>
