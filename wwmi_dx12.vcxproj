  <UsingTask TaskName="WwmiWriteShaderPairsSeed" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
string root = Root.TrimEnd('\\');
var text = new StringBuilder();
text.Append("// GENERATED by wwmi_dx12.vcxproj (WwmiShaderPairsSeed) from shaderpairs\\wwmi_dx12_seed.shaderpairs -- do not edit, not tracked.\r\n");
text.Append("#pragma once\r\ninline const char* const kShaderPairsSeed[] = {\r\n");
foreach (string line in File.ReadAllLines(Path.Combine(root, @"shaderpairs\wwmi_dx12_seed.shaderpairs")))
    text.Append("    \"" + line.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\",\r\n");
text.Append("    \"\",\r\n};\r\n");
string output = Path.Combine(root, @"reshade_addon\mods\shader_pairs_seed.h");
if (!File.Exists(output) || File.ReadAllText(output) != text.ToString()) File.WriteAllText(output, text.ToString(), Encoding.ASCII);
]]></Code>
    </Task>
  </UsingTask>
